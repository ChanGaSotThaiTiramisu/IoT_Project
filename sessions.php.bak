<?php

error_reporting(E_ALL);
ini_set('display_errors', 1);

session_start();

if (!isset($_SESSION['user_id'])) {
    header("Location: index.php");
    exit;
}

require_once "db.php";

/* =========================
   START SESSION
========================= */

if (isset($_GET['start'])) {

    $id = intval($_GET['start']);

    $stmt = $conn->prepare(
        "UPDATE sessions
         SET status = 'running',
             started_at = NOW()
         WHERE id = ?
         AND status = 'waiting'"
    );

    $stmt->bind_param("i", $id);
    $stmt->execute();

    header("Location: sessions.php");
    exit;
}


/* =========================
   FINISH SESSION
========================= */

if (isset($_GET['finish'])) {

    $id = intval($_GET['finish']);

    $stmt = $conn->prepare(
        "UPDATE sessions
         SET status = 'finished',
             ended_at = NOW()
         WHERE id = ?
         AND status = 'running'"
    );

    $stmt->bind_param("i", $id);
    $stmt->execute();

    header("Location: sessions.php");
    exit;
}


/* =========================
   CREATE SESSION
========================= */

if (
    $_SERVER["REQUEST_METHOD"] === "POST"
    && isset($_POST['create_session'])
) {

    $session_name = trim($_POST['session_name']);
    $question_set_id = intval($_POST['question_set_id']);

    if ($session_name !== "" && $question_set_id > 0) {

        $stmt = $conn->prepare(
            "INSERT INTO sessions
            (session_name, question_set_id, status)
            VALUES (?, ?, 'waiting')"
        );

        $stmt->bind_param(
            "si",
            $session_name,
            $question_set_id
        );

        $stmt->execute();

        header("Location: sessions.php?created=1");
        exit;
    }
}


/* =========================
   GET QUESTION SETS
========================= */

$question_sets = [];

$result = $conn->query(
    "SELECT *
     FROM question_sets
     ORDER BY id DESC"
);

while ($row = $result->fetch_assoc()) {
    $question_sets[] = $row;
}


/* =========================
   GET SESSIONS
========================= */

$sessions = [];

$result = $conn->query(
    "SELECT
        s.*,
        qs.set_name,
        COUNT(r.id) AS response_count
     FROM sessions s

     LEFT JOIN question_sets qs
        ON s.question_set_id = qs.id

     LEFT JOIN responses r
        ON s.id = r.session_id

     GROUP BY s.id

     ORDER BY s.id DESC"
);

while ($row = $result->fetch_assoc()) {
    $sessions[] = $row;
}

?>

