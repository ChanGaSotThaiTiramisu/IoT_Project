                                            ▶ Start
                                        </a>

                                    <?php elseif (
                                        $session['status']
                                        === 'running'
                                    ): ?>

                                        <a
                                            href="results.php?session=<?= $session['id'] ?>"
                                            class="action-btn"
                                        >
                                            Live Results
                                        </a>

                                        <a
                                            href="sessions.php?finish=<?= $session['id'] ?>"
                                            class="delete-btn"
                                            onclick="return confirm('Kết thúc Session này?');"
                                        >
                                            ■ Stop
                                        </a>

                                    <?php else: ?>

                                        <a
                                            href="results.php?session=<?= $session['id'] ?>"
                                            class="action-btn"
