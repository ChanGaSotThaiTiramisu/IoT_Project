                                    <?php elseif (
                                        $session['status']
                                        === 'running'
                                    ): ?>

                                        <span class="status running">
                                            RUNNING
                                        </span>

                                    <?php else: ?>

                                        <span class="status finished">
                                            FINISHED
                                        </span>

                                    <?php endif; ?>

                                </td>


                                <td>

                                    <?= $session[
                                        'response_count'
                                    ] ?>

                                </td>


                                <td>

                                    <?php if (
                                        $session['started_at']
                                    ): ?>

                                        <?= $session[
                                            'started_at'
                                        ] ?>

                                    <?php else: ?>

                                        Chưa bắt đầu

                                    <?php endif; ?>

                                </td>


                                <td>

                                    <?php if (
                                        $session['status']
                                        === 'waiting'
                                    ): ?>

                                        <a
                                            href="sessions.php?start=<?= $session['id'] ?>"
                                            class="action-btn"
